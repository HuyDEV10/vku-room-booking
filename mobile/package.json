{
  "name": "vku-room-booking",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~57.0.27",
    "expo-crypto": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-java": "^2.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:web": "expo export --platform web",
    "build:android": "expo export --platform android --output-dir dist-android",
    "format": "prettier --config .prettierrc.json --write App.tsx src tests app.json package.json tsconfig.json ../backend/src/**/*.java ../docs/*.md ../README.md",
    "test:e2e": "node tests/booking.e2e.mjs",
    "build:ios": "expo export --platform ios --output-dir dist-ios"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
